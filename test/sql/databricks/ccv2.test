# name: test/sql/databricks/ccv2.test
# description: test
# group: [databricks]

# Require statement will ensure this test is run with this extension loaded
require parquet

require uc_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

statement ok
call enable_logging(level='debug');

statement ok
CREATE SECRET (
    TYPE UC,
    TOKEN '${DATABRICKS_TOKEN}',
    ENDPOINT '${DATABRICKS_ENDPOINT}',
    AWS_REGION '${DATABRICKS_REGION}'
);

statement ok
ATTACH 'ccv2-test' as db (TYPE UC_CATALOG, DEFAULT_SCHEMA 'main');

query II
SELECT a, b FROM db.main.test1 order by a;
----
value-1	value-2
value-3	value-4

